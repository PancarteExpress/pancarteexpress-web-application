generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// Tables en lien avec les utilisateurs et les groupes :
// -- User : gere le stockage des informations des courtiers inscrit chez PancarteExpress
// -- VerificationToken : permet de valider qu'un compte crée n'est pas un bot (evite le spamming)
//                        Tant que le VerificationToken n'est pas entré, le User ne se crée pas
// -- Session : permet de faire le tracking lorsqu'un user est connecté
// -- Group : permet la gestion d'un group

model User {
  id          String  @id @default(cuid())
  email       String  @unique
  firstName   String?
  lastName    String?
  phoneNumber String?
  companyName String?

  emailVerified DateTime?
  password      String? // null si OAuth

  provider          String? // "google" ou null
  providerAccountId String? // ID unique chez le provider

  orders        Order[]   @relation("OrderOwner")
  billedOrders  Order[]   @relation("OrderBilledTo")

  role        UserRole    @default(user)
  groupStatus GroupStatus @default(SOLO)
  groupId     String?
  group       Group?      @relation("GroupUsers", fields: [groupId], references: [id], onDelete: SetNull)

  serviceBlockStartsAt DateTime?

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([email])
  @@index([groupId])
  @@index([groupStatus])
}

model VerificationToken {
  id       String    @id @default(cuid())
  email    String
  token    String
  expires  DateTime
  type     TokenType @default(EMAIL_VERIFICATION)
  attempts Int       @default(0)

  @@index([email, type])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Group {
  id          String      @id @default(cuid())
  name        String?     @unique
  billingMode BillingMode @default(INDIVIDUAL)
  users       User[]      @relation("GroupUsers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

enum UserRole {
  user
  groupAdmin
  superAdmin
}

enum GroupStatus {
  SOLO
  PENDING
  JOINED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum BillingMode {
  INDIVIDUAL // chaque membre paie ses propres commandes
  GROUP      // le groupAdmin paie toutes les commandes de l'équipe, y compris les siennes
}

// Tables en lien avec les commandes (Services et Produits) :
// -- Order : contient toutes les informations d'une commande (Services et Produits)
// -- OrderProduct : Un produit de la boutique commandé
// -- ServiceRequest : Une demande de service complete
// -- ServiceAddress : L'adresse liée à un service
// -- Service : Un service

model Order {
  id             String @id @default(cuid())
  orderNumber    Int    @unique @default(autoincrement())
  idempotencyKey String @unique

  // Nullable : commande invité, ou compte supprimé (on garde l'historique comptable)
  userId String?
  user   User?   @relation("OrderOwner", fields: [userId], references: [id], onDelete: SetNull)

  firstName String
  lastName  String
  email     String
  phone     String?

  // Qui doit payer les services, figé à la création selon le mode du groupe à ce moment.
  // Sert au suivi manuel de la facturation. null = invité.
  billedToId String?
  billedTo   User?   @relation("OrderBilledTo", fields: [billedToId], references: [id], onDelete: SetNull)

  // null si services seulement
  deliveryMode       DeliveryMode?
  deliveryStreet     String?
  deliveryCity       String?
  deliveryPostalCode String?
  deliveryProvince   String?

  // Montants en cents, figés au moment de la commande
  subtotal Int
  tps      Int
  tvq      Int
  total    Int

  paymentIntentId String?   @unique
  paidAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products        OrderProduct[]
  productsStatus  ProductsStatus?
  serviceRequests ServiceRequest[]
  status          OrderStatus

  @@index([userId, createdAt]) // historique du dashboard
  @@index([status, createdAt]) // cron de nettoyage + vue SuperAdmin
  @@index([billedToId, createdAt])
}

model OrderProduct {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productSlug String // slug du catalogue ; plus de clé étrangère
  productName String // copie figée (fr)
  unitPrice   Int // cents, copie figée
  quantity    Int

  @@index([orderId])
  @@index([productSlug]) // statistiques de ventes par produit
}

model ServiceRequest {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  requestType RequestType

  addresses ServiceAddress[]

  @@index([orderId])
}

model ServiceAddress {
  id               String         @id @default(cuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  kind AddressKind // civicaddress | terrain

  // Adresse civique
  streetNumber String?
  streetName   String?
  apartment    String?
  postalCode   String?

  // Terrain
  description   String? @db.Text
  nearbyAddress String?

  city String

  services Service[]

  @@index([serviceRequestId])
  @@index([city])
}

model Service {
  id               String         @id @default(cuid())
  serviceAddressId String
  serviceAddress   ServiceAddress @relation(fields: [serviceAddressId], references: [id], onDelete: Cascade)

  type   ServiceType // installation | removal | correction
  price  Int? // prix envoyé au client
  status ServiceStatus @default(TO_SCHEDULE)

  scheduledFor DateTime?
  completedAt  DateTime?

  details Json // validé par Zod à l'écriture

  @@index([serviceAddressId])
  @@index([type])
  @@index([status, scheduledFor]) // NOUVEAU : planning du SuperAdmin
}

enum OrderStatus {
  AWAITING_PAYMENT
  PENDING
  PAID
  COMPLETED
  CANCELLED
}

enum ProductsStatus {
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
}

enum DeliveryMode {
  PICKUP
  DELIVERY
}

enum AddressKind {
  civicAddress
  terrain
}

enum RequestType {
  residential
  commercial
}

enum ServiceType {
  installation
  removal
  correction
}

enum ServiceStatus {
  TO_SCHEDULE
  SCHEDULED
  COMPLETED
  CANCELLED
}
