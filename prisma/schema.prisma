generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}


// Tables en lien avec les utilisateurs et les groupes :
// -- User : gere le stockage des informations des courtiers inscrit chez PancarteExpress
// -- VerificationToken : permet de valider qu'un compte crée n'est pas un bot (evite le spamming)
//                        Tant que le VerificationToken n'est pas entré, le User ne se crée pas
// -- Session : permet de faire le tracking lorsqu'un user est connecté
// -- Group : permet la gestion d'un group

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  firstName     String?
  lastName      String?
  phoneNumber   String?   
  companyName   String?
  
  emailVerified DateTime?
  password      String?   // null si OAuth

  provider           String?   // "google" ou null
  providerAccountId  String?   // ID unique chez le provider

  orders        Order[]

  role          UserRole  @default(user)
  groupStatus   GroupStatus  @default(SOLO)
  groupId       String?
  group         Group?    @relation("GroupUsers", fields: [groupId], references: [id], onDelete: SetNull)

  sessions      Session[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([provider, providerAccountId])
  @@index([email])
  @@index([groupId])
  @@index([groupStatus])
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  type      TokenType @default(EMAIL_VERIFICATION)

  @@unique([email, token])
  @@index([email])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Group {
  id        String   @id @default(cuid())
  name      String
  users     User[]   @relation("GroupUsers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

enum UserRole {
  user
  admin
}

enum GroupStatus {
  SOLO
  PENDING
  JOINED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}






////////////////////////////////////

model Order {
  id                 String             @id @default(cuid())
  orderNumber        Int                @unique @default(autoincrement())
  idempotencyKey     String             @unique
  status             OrderStatus

  // Nullable : commande invité, ou compte supprimé (on garde l'historique comptable)
  userId             String?
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName          String
  lastName           String
  email              String

  fulfillmentMethod  FulfillmentMethod? // null si services seulement
  shippingStreet     String?
  shippingCity       String?
  shippingPostalCode String?
  shippingProvince   String?

  // Montants en cents, figés au moment de la commande
  productsSubtotal   Int
  servicesSubtotal   Int
  shippingFee        Int
  subtotal           Int
  tps                Int
  tvq                Int
  total              Int

  paymentIntentId    String?            @unique
  paidAt             DateTime?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  items              OrderItem[]
  serviceRequests    ServiceRequest[]

  @@index([userId, createdAt])  // historique du dashboard
  @@index([status, createdAt])  // cron de nettoyage + vue SuperAdmin
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String // slug du catalogue ; plus de clé étrangère
  productName String // copie figée (fr)
  unitPrice   Int    // cents, copie figée
  quantity    Int

  @@index([orderId])
  @@index([productId]) // statistiques de ventes par produit
}

model ServiceRequest {
  id          String           @id @default(cuid())
  orderId     String
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestType RequestType

  addresses   ServiceAddress[]

  @@index([orderId])
}

model ServiceAddress {
  id               String         @id @default(cuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  kind             AddressKind
  // Adresse civique
  streetNumber     String?
  streetName       String?
  apartment        String?
  postalCode       String?
  // Terrain
  description      String?        @db.Text
  nearbyAddress    String?
  // Commun
  city             String

  services         Service[]

  @@index([serviceRequestId])
  @@index([city])
}

model Service {
  id               String         @id @default(cuid())
  serviceAddressId String
  serviceAddress   ServiceAddress @relation(fields: [serviceAddressId], references: [id], onDelete: Cascade)

  type             ServiceType
  unitPrice        Int            // cents, figé
  details          Json           // validé par Zod à l'écriture

  @@index([serviceAddressId])
  @@index([type])
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FulfillmentMethod {
  PICKUP
  DELIVERY
}

// Valeurs identiques aux types client existants : aucune couche de conversion
enum RequestType {
  residential
  commercial
}

enum AddressKind {
  address
  terrain
}

enum ServiceType {
  installation
  removal
  correction
}