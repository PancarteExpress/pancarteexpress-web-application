generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// Tables en lien avec les utilisateurs et les groupes :
// -- User : les courtiers inscrits chez Pancarte Express
// -- VerificationToken : codes à usage unique (réinitialisation du mot de passe, etc.)
// -- Session : sessions des utilisateurs connectés
// -- Group : une équipe de courtiers, gérée par un groupAdmin

model User {
  id          String  @id @default(cuid())
  email       String  @unique
  username    String? @unique
  firstName   String?
  lastName    String?
  phoneNumber String?
  companyName String?
  /** Adresse de facturation saisie à l'inscription */
  billingAddress String?
  needsPickupInfo Boolean    @default(false)
  pickupInfo  PickupInfo?

  emailVerified DateTime?
  password      String? // null si OAuth

  provider          String? // "google" ou null
  providerAccountId String? // ID unique chez le provider

  orders       Order[] @relation("OrderOwner")
  billedOrders Order[] @relation("OrderBilledTo")

  role        UserRole    @default(user)
  groupStatus GroupStatus @default(SOLO)
  groupId     String?
  group       Group?      @relation("GroupUsers", fields: [groupId], references: [id], onDelete: SetNull)
  // Entrée dans le groupe actuel : le groupAdmin ne voit que les commandes postérieures. null = sans groupe
  joinedAt    DateTime?

  // Blocage manuel des demandes de service par le superAdmin :
  // date à partir de laquelle elles sont refusées (clic + 3 jours). null = aucun blocage.
  serviceBlockStartsAt DateTime?
  // Courriel « blocage effectif » envoyé par le cron ; null = à envoyer dès que serviceBlockStartsAt est passé
  serviceBlockNoticeSentAt DateTime?

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locale Locale @default(fr)

  @@unique([provider, providerAccountId])
  @@index([groupId])
  @@index([groupStatus])
}

model VerificationToken {
  id       String    @id @default(cuid())
  email    String
  token    String
  expires  DateTime
  type     TokenType @default(EMAIL_VERIFICATION)
  attempts Int       @default(0)

  @@index([email, type])
}

model PickupInfo {
  id            String     @id @default(cuid())
  userId        String     @unique
  mode          PickupMode
  address       String?
  city          String?
  postalCode    String?
  receptionDate DateTime?  @db.Date
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Group {
  id          String      @id @default(cuid())
  name        String?     @unique
  billingMode BillingMode @default(INDIVIDUAL)
  users       User[]      @relation("GroupUsers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Locale {
  fr
  en
}

enum UserRole {
  user
  groupAdmin
  superAdmin
}

enum GroupStatus {
  SOLO
  PENDING
  JOINED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum PickupMode {
  ADDRESS
  WAREHOUSE
}

enum BillingMode {
  INDIVIDUAL // chaque membre paie ses propres commandes
  GROUP // le groupAdmin paie toutes les commandes de l'équipe, y compris les siennes
}

// Tables en lien avec les commandes (Services et Produits) :
// -- Order : une commande complète (produits et/ou services)
// -- OrderProduct : un produit de la boutique commandé
// -- ServiceRequest : une demande de service complète
// -- ServiceAddress : l'adresse liée à un service
// -- Service : un service

model Order {
  id             String @id @default(cuid())
  orderNumber    Int    @unique @default(autoincrement())
  idempotencyKey String @unique

  // Nullable : commande invité, ou compte supprimé (on garde l'historique comptable)
  userId String?
  user   User?   @relation("OrderOwner", fields: [userId], references: [id], onDelete: SetNull)

  firstName String
  lastName  String
  email     String
  phone     String?

  // Invités seulement (les membres ont ces informations dans leur compte)
  companyName    String?
  billingAddress String?
  additionalInfo String?

  // Qui doit payer les services, figé à la création selon le mode du groupe à ce moment.
  // Sert au suivi manuel de la facturation. null = invité.
  billedToId    String?
  billedTo      User?   @relation("OrderBilledTo", fields: [billedToId], references: [id], onDelete: SetNull)
  // Copie figée : reste lisible même si le compte du payeur est supprimé
  billedToEmail String?

  // null si services seulement
  deliveryMode       DeliveryMode?
  deliveryStreet     String?
  deliveryCity       String?
  deliveryPostalCode String?
  deliveryProvince   String?

  // Montants des produits en cents, figés au moment de la commande
  subtotal Int
  tps      Int
  tvq      Int
  total    Int

  paymentIntentId String?   @unique
  paidAt          DateTime?

  // Date d'envoi de chaque courriel de commande ; null = à (r)envoyer par le cron quotidien
  internalReceiptSentAt DateTime?
  clientReceiptSentAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products        OrderProduct[]
  productsStatus  ProductsStatus?
  serviceRequests ServiceRequest[]
  status          OrderStatus

  locale Locale @default(fr)

  @@index([userId, createdAt]) // historique du dashboard
  @@index([status, createdAt]) // cron de nettoyage + vue SuperAdmin
  @@index([billedToId, createdAt]) // suivi de la facturation par payeur
}

model OrderProduct {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productSlug String // slug du catalogue ; plus de clé étrangère
  productName String // copie figée (fr)
  unitPrice   Int // cents, copie figée
  quantity    Int

  @@index([orderId])
  @@index([productSlug]) // statistiques de ventes par produit
}

model ServiceRequest {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  requestType RequestType

  addresses ServiceAddress[]

  @@index([orderId])
}

model ServiceAddress {
  id               String         @id @default(cuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  addressNumber    Int            @unique @default(autoincrement())
  
  kind AddressKind // civicAddress | terrain

  // Adresse civique
  streetNumber String?
  streetName   String?
  apartment    String?
  postalCode   String?

  // Terrain
  description   String? @db.Text
  nearbyAddress String?

  city String

  /// Délai propre à l'adresse ; null pour le grand format (pas de délai)
  delay         ServiceDelay?
  requestedDate DateTime?    @db.Date

  services Service[]
  attachments ServiceAttachment[]

  optimoSyncStatus OptimoSyncStatus @default(PENDING)
  optimoRouteId    String?
  optimoSyncError  String?
  optimoSyncedAt   DateTime?

  // Courriel interne détaillé de ce numéro PE ; null = à (r)envoyer par le cron quotidien
  internalEmailSentAt DateTime?

  @@index([serviceRequestId])
  @@index([city])
  @@index([optimoSyncStatus])
}

model Service {
  id               String         @id @default(cuid())
  serviceAddressId String
  serviceAddress   ServiceAddress @relation(fields: [serviceAddressId], references: [id], onDelete: Cascade)

  type   ServiceType // installation | removal | correction
  // Prix en cents, réservé à la facturation manuelle (non utilisé pour l'instant)
  price  Int?
  status ServiceStatus @default(TO_SCHEDULE)

  scheduledFor DateTime?
  completedAt  DateTime?

  details Json // validé par Zod à l'écriture

  // @default(now()) : remplit les lignes existantes lors de la migration
  updatedAt DateTime @default(now()) @updatedAt

  @@index([serviceAddressId])
  @@index([type])
  @@index([status, scheduledFor]) // planning du SuperAdmin
}

enum OrderStatus {
  AWAITING_PAYMENT
  PENDING
  PAID
  COMPLETED
  CANCELLED
}

enum ProductsStatus {
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
}

enum DeliveryMode {
  PICKUP
  DELIVERY
}

enum AddressKind {
  civicAddress
  terrain
}

enum RequestType {
  residential
  commercial
}

enum ServiceType {
  installation
  removal
  correction
  pickup
  delivery
  largeInstallation
  largeStoragePickup
  largeRetrieval
}

enum ServiceStatus {
  TO_SCHEDULE
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ServiceDelay {
  standard24h
  urgent12h
  sameDay
  specificDate
}

enum OptimoSyncStatus {
  PENDING
  SYNCED
  FAILED
}

/// Pièce jointe d'une adresse de service (photo, plan, document), dans le stockage privé Vercel Blob
model ServiceAttachment {
  id               String         @id @default(cuid())
  serviceAddressId String
  serviceAddress   ServiceAddress @relation(fields: [serviceAddressId], references: [id], onDelete: Cascade)

  /// Chemin dans le stockage privé (ex. attachments/plan-x7Kq2.pdf)
  pathname    String @unique
  /// Nom d'origine du fichier, pour l'affichage
  fileName    String
  contentType String
  /// Taille en octets
  size        Int

  createdAt DateTime @default(now())

  @@index([serviceAddressId])
}

/// Tentatives d'envoi du formulaire de contact, pour limiter le nombre d'envois par IP.
/// L'IP est hachée : aucune adresse en clair n'est conservée. Nettoyé par le cron quotidien.
model ContactAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}